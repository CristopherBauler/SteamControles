{
  "name": "steam-wishlist-dashboard",
  "version": "2.0.1",
  "private": true,
  "description": "Dashboard local da wishlist Steam (PC e Obsidian, preços em BRL).",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "login": "node Scripts/steamLogin.js",
    "serve": "node Scripts/controlServer.js",
    "update": "node Scripts/updateWishlist.js",
    "panel": "node Scripts/updateWishlist.js --panel-only",
    "update:daily": "node Scripts/updateWishlist.js --daily",
    "install:scheduler": "powershell -ExecutionPolicy Bypass -File Scripts/installScheduler.ps1",
    "app": "electron .",
    "app:build": "electron-builder --win portable",
    "docs:pdf": "electron Scripts/buildDocsPdf.js",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:apk": "npm --prefix mobile run apk"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.steamcontroles.app",
    "productName": "Minha Loja dos Desejos",
    "asar": true,
    "asarUnpack": [
      "desktop/icon.png",
      "desktop/icon.ico",
      "desktop/icon-default.png"
    ],
    "files": [
      "desktop/**/*",
      "Scripts/**/*",
      "Snippets/game-wishlist-dashboard.css",
      "SteamControles.cmd",
      "SteamControles.vbs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SteamControles.exe"
    }
  }
}
